# Production Lite Environment Configuration
# Minimal production settings for metal project

# Build Configuration
SWIFT_BUILD_CONFIG=release
METAL_OPTIMIZATION_LEVEL=3
ENABLE_DEBUG_SYMBOLS=false

# Performance Settings
DEFAULT_TEXTURE_SIZE=1024
MAX_THREADGROUP_SIZE=256
ENABLE_FAST_MATH=true

# Logging
LOG_LEVEL=info
ENABLE_PERFORMANCE_LOGGING=true
ENABLE_DEBUG_LOGGING=false

# Metal Shader Settings
METAL_LIBRARY_PATH=./shaders.metal
ENABLE_SHADER_VALIDATION=true
METAL_SDK=macosx

# Resource Limits
MAX_BUFFER_SIZE_MB=512
MAX_TEXTURE_SIZE=4096
ENABLE_MEMORY_WARNINGS=true
