use flake

# Load production lite environment
dotenv prod_lite.env

# Add bin directory to PATH
PATH_add bin

# Set Metal-specific environment variables
export METAL_DEVICE_WRAPPER_TYPE=1
export METAL_DEBUG_ERROR_MODE=0
export METAL_PERFORMANCE_HUD=0

# Swift development settings
export SWIFT_EXEC=/usr/bin/swift
export SWIFT_BUILD_PATH=.build

# Development shortcuts
alias m="./bin/metal"
alias bench="./bin/benchmark"
alias validate="swift hack/validate_metal.swift"
