#!/usr/bin/env swift

import Foundation

// Quick performance benchmark runner
struct BenchmarkRunner {
    func run() {
        print("Metal Performance Benchmark")
        print("===========================")

        let iterations = 50
        let textureSize = 1024

        print("Configuration:")
        print("  Texture size: \(textureSize)x\(textureSize)")
        print("  Iterations: \(iterations)")
        print()

        // Run demo and capture timing
        let start = CFAbsoluteTimeGetCurrent()

        let process = Process()
        process.launchPath = "/usr/bin/swift"
        process.arguments = ["run", "demo"]

        let pipe = Pipe()
        process.standardOutput = pipe
        process.launch()
        process.waitUntilExit()

        let elapsed = CFAbsoluteTimeGetCurrent() - start

        if process.terminationStatus == 0 {
            print("✓ Benchmark completed in \(String(format: "%.2f", elapsed))s")

            // Parse output for performance metrics
            let data = pipe.fileHandleForReading.readDataToEndOfFile()
            if let output = String(data: data, encoding: .utf8) {
                parsePerformanceMetrics(output)
            }
        } else {
            print("✗ Benchmark failed")
        }
    }

    private func parsePerformanceMetrics(_ output: String) {
        let lines = output.components(separatedBy: .newlines)

        for line in lines {
            if line.contains("Avg") && line.contains("ms") {
                print("  \(line)")
            }
        }
    }
}

BenchmarkRunner().run()
